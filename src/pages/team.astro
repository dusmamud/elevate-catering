---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { team } from '../data/site';
const lead = 'Chefs and event captains from Mumbai’s finest kitchens — the people who will actually cook and run your event.';
---
<Layout title="Our Team — Elevate Catering" description={lead} lead={lead}>
  <PageHero eyebrow="Our Team" title="The hands behind the feast." lead={lead} />
  <section class="bg-cream px-4 pb-14 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-4 sm:grid-cols-2">
      {team.map((m) => (
        <article class="reveal grid overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-line sm:grid-cols-[220px_1fr]">
          <img src={m.img} alt={`Portrait — ${m.name}`} width="640" height="640" loading="lazy" class="h-full w-full object-cover" />
          <div class="p-6"><h2 class="font-display text-2xl font-bold text-forest">{m.name}</h2><p class="mt-1 text-sm font-semibold text-gold-deep">{m.role}</p><p class="mt-3 leading-relaxed text-ink/70">{m.bio}</p></div>
        </article>
      ))}
    </div>
    <p class="reveal mx-auto mt-8 max-w-3xl text-center text-sm text-ink/60">Plus 40+ trained service staff, bartenders and event captains on every large event — all uniformed, all briefed on your menu and your guests’ dietary needs.</p>
  </section>
  <ContactCTA />
</Layout>
