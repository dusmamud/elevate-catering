---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — Elevate Catering" description="This page does not exist. Head back to the Elevate Catering home page.">
  <section class="flex min-h-[70vh] flex-col items-center justify-center bg-cream px-4 pt-24 text-center">
    <p class="font-display text-8xl font-bold gold">404</p>
    <h1 class="mt-4 font-display text-3xl font-bold text-forest">This plate is empty.</h1>
    <p class="mt-2 max-w-md text-sm text-ink/70">The link may be old, or the page may have moved. The good news: the menu is right here.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-cream transition hover:bg-gold hover:text-forest">Back to Home</a>
      <a href="/menus/" class="rounded-full border border-forest/25 px-6 py-3 text-sm font-semibold text-forest transition hover:border-gold hover:text-gold-deep">See Our Menus</a>
    </div>
  </section>
</Layout>
