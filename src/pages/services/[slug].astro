---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { services, menus } from '../../data/site';
export function getStaticPaths() { return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } })); }
const { service } = Astro.props;
const description = `${service.short} ${service.title} by Elevate Catering — ${service.price.toLowerCase()}, tasting included.`;
const jsonLd = { '@context': 'https://schema.org', '@type': 'Service', name: service.title, description, serviceType: service.title, areaServed: 'India', provider: { '@type': 'FoodEstablishment', name: 'Elevate Catering', url: 'https://elevate-catering.pages.dev/', telephone: '+91 98765 43210', priceRange: '₹₹' } };
const lead = `${service.title} — ${service.short} Starting ${service.price.toLowerCase()}.`;
---
<Layout title={`${service.title} — Elevate Catering`} description={description} jsonLd={jsonLd} lead={lead}>
  <PageHero eyebrow={`Service ${service.num}`} title={service.title} lead={lead} />
  <section class="bg-cream px-4 pb-14 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <Picture src={service.img} alt={service.title} width="1200" height="700" fetchpriority="high" sizes="(max-width: 1152px) 100vw, 1152px" class="reveal aspect-[16/9] w-full rounded-3xl object-cover" />
      <div class="mt-10 grid gap-10 lg:grid-cols-[1.2fr_1fr]">
        <div class="reveal">
          <h2 class="font-display text-2xl font-bold text-forest">What's on the table</h2>
          <ul class="mt-4 space-y-3">{service.points.map((p) => (<li class="flex items-start gap-3 rounded-2xl bg-white p-4 text-sm shadow-sm ring-1 ring-line"><span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-gold text-xs font-black text-forest">✓</span>{p}</li>))}</ul>
          <h2 class="mt-10 font-display text-2xl font-bold text-forest">Always included</h2>
          <ul class="mt-4 space-y-2 text-sm text-ink/75">{service.includes.map((p) => (<li>✓ {p}</li>))}</ul>
          <h2 class="mt-10 font-display text-2xl font-bold text-forest">Menus that fit</h2>
          <div class="mt-4 flex flex-wrap gap-2">{menus.map((m) => (<a href={`/menus/${m.slug}/`} class="rounded-full border border-forest/25 px-4 py-2 text-sm font-semibold text-forest transition hover:border-gold hover:text-gold-deep">{m.title} — {m.price}/guest</a>))}</div>
        </div>
        <aside class="reveal h-fit rounded-2xl bg-forest p-6 text-cream">
          <p class="font-display text-3xl font-bold">{service.price}</p>
          <p class="mt-1 text-sm text-cream/70">Transparent per-person pricing. Final fixed quote after a free tasting.</p>
          <a href="/quote/" class="mt-5 block rounded-full bg-gold px-6 py-3 text-center text-sm font-bold text-forest transition hover:bg-cream">Get a Quote →</a>
          <a href="/contact/" class="mt-3 block rounded-full border border-white/30 px-6 py-3 text-center text-sm font-bold transition hover:bg-white/10">Talk to us →</a>
          <a href="/process/" class="mt-3 block text-center text-sm font-semibold underline underline-offset-4">See how it works</a>
          <a href="/pricing/" class="mt-2 block text-center text-sm font-semibold underline underline-offset-4">Compare packages</a>
          <a href="/faq/" class="mt-2 block text-center text-sm font-semibold underline underline-offset-4">Read the FAQ</a>
        </aside>
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        {services.filter((s) => s.slug !== service.slug).map((s) => (<a href={`/services/${s.slug}/`} class="rounded-full border border-forest/25 px-4 py-2 text-sm font-semibold text-forest transition hover:border-gold hover:text-gold-deep">{s.num} {s.title} →</a>))}
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
