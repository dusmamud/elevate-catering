---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { featuredEvents } from '../../data/site';
const cats = ['All', ...new Set(featuredEvents.map((e) => e.type))];
const lead = 'Featured events, told properly: the venue, the guest count, the menu and what the hosts said afterwards. Filter by event type to find a day like yours.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Featured Events — Elevate Catering', description: lead };
---
<Layout title="Featured Events — Elevate Catering" description={lead} jsonLd={jsonLd} lead={lead}>
  <PageHero eyebrow="Featured Events" title="Events we are proud of." lead={lead} />
  <section class="bg-cream px-4 pb-14 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div id="project-filter" class="reveal flex flex-wrap gap-2" role="group" aria-label="Filter events by type">
        {cats.map((c, i) => (<button type="button" data-filter={c} aria-pressed={i === 0 ? 'true' : 'false'} class:list={['rounded-full border px-4 py-2 text-sm font-semibold transition', i === 0 ? 'border-gold bg-gold text-forest' : 'border-line bg-white text-ink/70 hover:border-gold']}>{c}</button>))}
      </div>
      <p id="filter-count" class="mt-3 text-sm text-ink/70" role="status">Showing {featuredEvents.length} of {featuredEvents.length} projects</p>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featuredEvents.map((e) => (
          <a href={`/events/${e.slug}/`} data-project-card data-category={e.type} class="reveal project-card group flex flex-col overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-line transition hover:ring-gold">
            <span class="block overflow-hidden"><Picture src={e.img} alt={e.title} width={800} height={560} sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" class="aspect-[10/7] w-full object-cover" /></span>
            <span class="flex flex-1 flex-col p-5">
              <span class="flex items-center justify-between gap-2"><span class="rounded-full bg-sage px-2.5 py-1 text-[11px] font-bold text-forest">{e.type}</span><span class="text-xs font-semibold text-ink/70">{e.dateLabel}</span></span>
              <span class="mt-3 font-display text-xl font-bold leading-snug text-forest group-hover:text-gold-deep">{e.title}</span>
              <span class="mt-1 text-sm text-ink/70">{e.venue} · {e.guestsLabel}</span>
              <span class="mt-2 flex-1 text-sm leading-relaxed text-ink/70">{e.summary}</span>
              <span class="mt-4 text-sm font-semibold text-gold-deep">Read the story <span class="card-arrow" aria-hidden="true">→</span></span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
