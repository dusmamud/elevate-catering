---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { processSteps } from '../data/site';
const lead = 'Six steps from first enquiry to the morning after — who you talk to, what happens, and what you approve at each stage.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'HowTo', name: 'How Elevate Catering works', step: processSteps.map((s) => ({ '@type': 'HowToStep', name: s.title, text: s.detail })) };
---
<Layout title="Our Process — Elevate Catering" description={lead} jsonLd={jsonLd} lead={lead}>
  <PageHero eyebrow="Our Process" title="Enquiry to event day, calmly." lead={lead} />
  <section class="bg-cream px-4 pb-14 sm:px-6">
    <div class="mx-auto max-w-4xl space-y-4">
      {processSteps.map((s) => (
        <article class="reveal rounded-3xl bg-white p-6 shadow-sm ring-1 ring-line sm:p-8">
          <div class="flex flex-wrap items-center gap-3">
            <span class="grid h-11 w-11 place-items-center rounded-full bg-gold font-display text-sm font-bold text-forest">{s.num}</span>
            <h2 class="font-display text-2xl font-bold text-forest">{s.title}</h2>
            <span class="ml-auto rounded-full bg-sage px-3 py-1 text-xs font-bold text-forest">{s.weeks}</span>
          </div>
          <p class="mt-3 text-sm font-semibold text-gold-deep">{s.who}</p>
          <p class="mt-2 leading-relaxed text-ink/70">{s.detail}</p>
          <p class="mt-3 rounded-xl bg-cream px-4 py-3 text-sm text-ink/70"><strong class="text-forest">Your approval:</strong> {s.approval}</p>
        </article>
      ))}
    </div>
    <div class="reveal mx-auto mt-8 flex max-w-4xl flex-wrap gap-3">
      <a href="/quote/" class="rounded-full bg-forest px-6 py-3 text-sm font-bold text-cream transition hover:bg-gold hover:text-forest">Start with an enquiry →</a>
      <a href="/faq/" class="rounded-full border border-forest/25 px-6 py-3 text-sm font-semibold text-forest transition hover:border-gold">Read the FAQ</a>
    </div>
  </section>
  <ContactCTA />
</Layout>
