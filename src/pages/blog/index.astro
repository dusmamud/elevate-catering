---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { blogPosts } from '../../data/site';
const jsonLd = { '@context': 'https://schema.org', '@type': 'Blog', name: 'Elevate Catering Journal', url: 'https://elevate-catering.pages.dev/blog/', blogPost: blogPosts.map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: `https://elevate-catering.pages.dev/blog/${p.slug}/`, datePublished: `${p.date}T00:00:00+05:30`, author: { '@type': 'Person', name: p.author } })) };
const lead = 'Honest guides from our kitchen — wedding menus, corporate catering, seasonal cooking, dietary care and what catering really costs.';
const categories = [...new Set(blogPosts.map((p) => p.category))];
---
<Layout title="Journal — Elevate Catering" description={lead} jsonLd={jsonLd} lead={lead}>
  <PageHero eyebrow="Journal" title="Notes from the kitchen." lead={lead} />
  <section class="bg-cream px-4 pb-14 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <div class="reveal flex flex-wrap gap-2" role="group" aria-label="Topics">
        <span class="rounded-full bg-gold px-4 py-2 text-sm font-bold text-forest">All topics</span>
        {categories.map((c) => (<span class="rounded-full border border-line bg-white px-4 py-2 text-sm font-semibold text-ink/70">{c}</span>))}
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {blogPosts.map((p) => (
          <a href={`/blog/${p.slug}/`} class="reveal group flex flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-line">
            <Picture src={p.img} alt={p.title} width="640" height="420" loading="lazy" class="aspect-[3/2] w-full object-cover transition group-hover:scale-105" />
            <div class="flex flex-1 flex-col p-5">
              <p class="text-xs font-bold uppercase tracking-wider text-gold-deep">{p.category} · {p.readingTime}</p>
              <h2 class="mt-2 font-display text-xl font-bold leading-tight text-forest group-hover:text-gold-deep">{p.title}</h2>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/70">{p.excerpt}</p>
              <p class="mt-4 text-xs font-semibold text-ink/70">By {p.author} · {p.authorRole} · {p.date}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
