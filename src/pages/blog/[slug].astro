---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { blogPosts, team } from '../../data/site';
export function getStaticPaths() { return blogPosts.map((p) => ({ params: { slug: p.slug }, props: { post: p } })); }
const { post } = Astro.props;
const author = team.find((t) => t.name === post.author);
const related = blogPosts.filter((p) => p.slug !== post.slug && p.category === post.category).concat(blogPosts.filter((p) => p.slug !== post.slug && p.category !== post.category)).slice(0, 3);
const wordCount = post.body.join(' ').split(/\s+/).length;
const jsonLd = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, description: post.excerpt, image: `https://elevate-catering.pages.dev${post.img}`, datePublished: `${post.date}T00:00:00+05:30`, dateModified: `${post.date}T00:00:00+05:30`, author: { '@type': 'Person', name: post.author, jobTitle: post.authorRole }, publisher: { '@type': 'Organization', name: 'Elevate Catering', url: 'https://elevate-catering.pages.dev/' }, mainEntityOfPage: `https://elevate-catering.pages.dev/blog/${post.slug}/`, wordCount };
const lead = post.excerpt;
---
<Layout title={post.seoTitle} description={post.excerpt} jsonLd={jsonLd} lead={lead} ogType="article" publishedTime={`${post.date}T00:00:00+05:30`}>
  <PageHero eyebrow={`${post.category} · ${post.readingTime}`} title={post.title} lead={lead} />
  <section class="bg-cream px-4 pb-14 sm:px-6">
    <div class="mx-auto max-w-6xl">
      <Picture src={post.img} alt={post.title} width="1200" height="800" fetchpriority="high" sizes="(max-width: 1152px) 100vw, 1152px" class="reveal aspect-[16/9] w-full rounded-3xl object-cover" />
      <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_300px]">
        <article class="reveal">
          <div class="flex items-center gap-3 border-b border-line pb-5">
            {author && (<Picture src={author.img} alt={`Portrait of ${author.name}`} width="96" height="96" loading="lazy" class="h-12 w-12 rounded-full object-cover" />)}
            <div><p class="font-display font-bold text-forest">{post.author}</p><p class="text-sm text-ink/70">{post.authorRole} · {post.date} · {post.readingTime} · {wordCount} words</p></div>
          </div>
          <p class="mt-6 border-l-4 border-gold pl-4 font-display text-xl font-bold leading-relaxed text-forest">{post.excerpt}</p>
          {post.body.map((para) => (<p class="mt-5 leading-relaxed text-ink/75">{para}</p>))}
          <div class="mt-10 rounded-2xl bg-forest p-6 text-cream">
            <h2 class="font-display text-xl font-bold">Planning an event?</h2>
            <p class="mt-2 text-sm text-cream/75">Tell us your date and guest count — we reply within one working day with availability and a tasting invite.</p>
            <a href="/quote/" class="mt-4 inline-block rounded-full bg-gold px-6 py-3 text-sm font-bold text-forest transition hover:bg-cream">Get a quote →</a>
          </div>
        </article>
        <aside class="reveal h-fit space-y-4 lg:sticky lg:top-28">
          <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-line">
            <h2 class="font-display text-lg font-bold text-forest">About the author</h2>
            {author && <p class="mt-2 text-sm leading-relaxed text-ink/65">{author.bio}</p>}
            <a href="/team/" class="mt-3 inline-block text-sm font-semibold text-gold-deep underline-offset-4 hover:underline">Meet the full team →</a>
          </div>
          <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-line">
            <h2 class="font-display text-lg font-bold text-forest">Read next</h2>
            <ul class="mt-3 space-y-3">{related.map((r) => (<li><a href={`/blog/${r.slug}/`} class="text-sm font-semibold leading-snug text-ink/80 transition hover:text-gold-deep">{r.title}</a><p class="text-xs text-ink/70">{r.category} · {r.readingTime}</p></li>))}</ul>
            <a href="/blog/" class="mt-4 inline-block text-sm font-semibold text-gold-deep underline-offset-4 hover:underline">All articles →</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
