---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactCTA from '../components/ContactCTA.astro';
import FaqPreview from '../components/FaqPreview.astro';
import { pricingPlans } from '../data/site';
const lead = 'Three packages, priced per guest, compared honestly. Every quote is fixed in writing after your tasting — the number you sign is the number you pay.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: pricingPlans.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Product', name: p.name, offers: { '@type': 'Offer', price: p.price.replace(/[^0-9]/g, ''), priceCurrency: 'INR' } } })) };
---
<Layout title="Pricing — Elevate Catering" description={lead} jsonLd={jsonLd} lead={lead}>
  <PageHero eyebrow="Pricing" title="Per-guest prices, in the open." lead={lead} />
  <section class="bg-cream px-4 pb-14 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-4 md:grid-cols-3">
      {pricingPlans.map((p) => (
        <article class:list={['reveal flex flex-col rounded-3xl p-7', p.popular ? 'bg-forest text-cream shadow-xl' : 'bg-white shadow-sm ring-1 ring-line']}>
          {p.popular && <p class="inline-block self-start rounded-full bg-gold px-3 py-1 text-[11px] font-black uppercase tracking-wider text-forest">Most popular</p>}
          <h2 class="mt-3 font-display text-2xl font-bold">{p.name}</h2>
          <p class:list={['mt-1 text-sm', p.popular ? 'text-cream/65' : 'text-ink/70']}>{p.bestFor} · {p.timeline}</p>
          <p class="mt-5 font-display text-4xl font-bold">{p.price}</p>
          <p class:list={['text-sm', p.popular ? 'text-cream/70' : 'text-ink/70']}>{p.per}</p>
          <ul class="mt-5 flex-1 space-y-2 text-sm">{p.features.map((f) => (<li class="flex gap-2"><span class={p.popular ? 'text-gold' : 'text-gold-deep'}>✓</span>{f}</li>))}</ul>
          <a href={`/quote/?plan=${p.slug}`} class:list={['mt-6 block rounded-full px-5 py-3 text-center text-sm font-bold transition', p.popular ? 'bg-gold text-forest hover:bg-cream' : 'bg-forest text-cream hover:bg-gold hover:text-forest']}>Get a quote →</a>
        </article>
      ))}
    </div>
    <div class="reveal mx-auto mt-10 max-w-3xl rounded-2xl bg-white p-6 text-sm leading-relaxed text-ink/70 shadow-sm ring-1 ring-line">
      <h2 class="font-display text-lg font-bold text-forest">What every package includes</h2>
      <p class="mt-2">Food, trained service staff, setup, standard crockery, cutlery and linen, plus complete cleanup. GST is shown separately on your proposal. Rentals beyond standard, decor and bar service are quoted in the same proposal — never added later. Drop-off catering starts at ₹850 per guest.</p>
    </div>
  </section>
  <FaqPreview />
  <ContactCTA />
</Layout>
