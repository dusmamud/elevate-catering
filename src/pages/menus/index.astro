---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { menus } from '../../data/site';
const lead = 'Four complete menus in HTML — courses, items, dietary tags and per-person prices. No PDFs, no "price on request". Pick one as-is, or customize every course.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: menus.map((m, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Menu', name: m.title, url: `https://elevate-catering.pages.dev/menus/${m.slug}/` } })) };
---
<Layout title="Menus — Elevate Catering" description={lead} jsonLd={jsonLd} lead={lead}>
  <PageHero eyebrow="Menus" title="Delicious options, priced openly." lead={lead} />
  <section class="bg-cream px-4 pb-14 sm:px-6">
    <div class="mx-auto grid max-w-6xl gap-4 md:grid-cols-2">
      {menus.map((m) => (
        <a href={`/menus/${m.slug}/`} class="reveal group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-line transition hover:ring-gold">
          <img src={m.img} alt={m.title} width="900" height="560" loading="lazy" class="aspect-[16/10] w-full object-cover transition group-hover:scale-105" />
          <div class="p-6">
            <p class="font-display text-3xl font-bold text-forest">{m.price}<span class="text-base font-normal text-ink/55"> {m.per}</span></p>
            <h2 class="mt-1 font-display text-2xl font-bold text-forest group-hover:text-gold-deep">{m.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink/65">{m.tagline}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">{m.dietary.map((d) => (<span class="rounded-full bg-sage px-2.5 py-1 text-[11px] font-bold text-forest">{d}</span>))}</div>
            <span class="mt-4 inline-block text-sm font-semibold text-gold-deep">See full menu →</span>
          </div>
        </a>
      ))}
    </div>
    <p class="reveal mx-auto mt-8 max-w-3xl text-center text-sm text-ink/60">Every menu is customizable — swap courses, add live counters, design Jain / vegan / gluten-free paths. <a href="/quote/" class="font-semibold text-gold-deep underline-offset-4 hover:underline">Tell us your date →</a></p>
  </section>
  <ContactCTA />
</Layout>
