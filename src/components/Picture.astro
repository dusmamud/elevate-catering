---
// Responsive picture for local masters in /images: AVIF -> WebP -> JPG,
// widths 480/800/1200/1600 generated by scripts/convert-images.mjs.
// Build-time reality check: only widths/formats whose variant file actually
// exists (and is non-empty) are advertised in srcset; if a stem has no
// variants yet, this renders a plain <img> with the master — run
// `node scripts/convert-images.mjs` and rebuild to upgrade it automatically.
// The picture wrapper is display:contents (.pic-wrap) so the img element
// keeps exactly the layout classes it had before this component existed.
import fs from 'node:fs';
import path from 'node:path';
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  sizes?: string;
  eager?: boolean;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  [key: string]: unknown;
}
const { src, alt, width = 800, height = 600, class: cls = '', sizes = '(max-width: 640px) 100vw, 800px', eager = false, loading, fetchpriority, ...rest } = Astro.props;
const stem = src.replace(/\.(jpe?g|png|webp|avif)$/i, '');
const widths = [480, 800, 1200, 1600];
const has = (w: number, ext: string) => {
  try {
    // NOTE: import.meta.url points at Astro's compiled output during build,
    // not at this source file — resolve against the project root instead.
    const p = path.join(process.cwd(), `public${stem}-${w}.${ext}`);
    return fs.statSync(p).size > 0;
  } catch { return false; }
};
const srcsetFor = (ext: string) => widths.filter((w) => has(w, ext)).map((w) => `${stem}-${w}.${ext} ${w}w`).join(', ');
const avifSet = srcsetFor('avif');
const webpSet = srcsetFor('webp');
const jpgSet = srcsetFor('jpg');
const fallbackSrc = jpgSet ? `${stem}-800.jpg` : src;
const load = loading ?? (eager ? 'eager' : 'lazy');
const fp = fetchpriority ?? (eager ? 'high' : undefined);
---
{avifSet || webpSet || jpgSet ? (
  <picture class="pic-wrap">
    {avifSet && <source type="image/avif" srcset={avifSet} sizes={sizes} />}
    {webpSet && <source type="image/webp" srcset={webpSet} sizes={sizes} />}
    <img src={fallbackSrc} srcset={jpgSet || undefined} sizes={sizes} alt={alt} width={width} height={height} loading={load} fetchpriority={fp} decoding="async" class={cls} {...rest} />
  </picture>
) : (
  <img src={src} alt={alt} width={width} height={height} loading={load} fetchpriority={fp} decoding="async" class={cls} {...rest} />
)}
