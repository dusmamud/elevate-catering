---
import { services } from '../data/site';
import Picture from './Picture.astro';
---
<section id="services" data-spy="services" class="bg-cream px-4 py-14 sm:px-6" aria-labelledby="services-heading">
  <div class="reveal relative mx-auto max-w-6xl rounded-3xl bg-white px-5 py-10 shadow-sm ring-1 ring-line sm:px-10">
    <span class="vertical-tab absolute left-0 top-10 hidden rounded-r-lg bg-gold px-1.5 py-3 text-[10px] font-bold uppercase tracking-widest text-forest lg:block">What we do</span>
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:pl-8">
      <div>
        <h2 id="services-heading" class="font-display text-3xl font-bold leading-tight text-forest sm:text-4xl">Our <span class="gold">Services</span></h2>
        <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink/65">Six ways we feed a celebration — every one starts with a tasting and a transparent per-person price.</p>
        <ul class="mt-8 space-y-3">
          {services.map((s) => (
            <li>
              <a href={`/services/${s.slug}/`} class="service-row flex items-center justify-between rounded-full border border-line px-5 py-3.5 text-sm font-semibold text-ink">
                <span><span class="service-num mr-3 font-display font-bold text-gold-deep">{s.num}</span>{s.title}</span>
                <span class="service-arrow text-ink/50" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="grid gap-4 sm:grid-cols-[1.2fr_1fr]">
        <div class="relative overflow-hidden rounded-2xl">
          <Picture src="/images/chef-plating.jpg" alt="An Elevate chef plating a signature dish" width="1000" height="667" loading="lazy" data-parallax-img class="h-full min-h-[280px] w-full scale-[1.08] object-cover" />
          <span class="absolute bottom-3 left-3 rounded-full bg-forest/85 px-3 py-1 text-xs font-semibold text-cream">Inside our kitchen</span>
        </div>
        <div class="flex flex-col gap-4">
          <a href="/gallery/" class="group flex flex-1 flex-col justify-between rounded-2xl border border-line p-5 transition hover:border-gold">
            <span class="text-sm text-ink/65">Wondering how an Elevate event looks?</span>
            <span class="mt-6 flex items-center gap-2 font-display text-lg font-bold text-forest">See the gallery <span class="text-gold-deep transition group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></span>
          </a>
          <a href="/team/" class="group flex flex-1 flex-col justify-between rounded-2xl bg-forest p-5 text-cream">
            <span class="text-sm font-medium text-cream/75">Looking for chefs who treat your event like their own?</span>
            <span class="mt-6 flex items-center gap-2 font-display text-lg font-bold">Meet our team <span class="transition group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
