---
export interface Props { items?: string[]; dark?: boolean }
const { items = ['Weddings', 'Corporate', 'Celebrations'], dark = false } = Astro.props;
const row = [...items, ...items, ...items];
---
<div class:list={['overflow-hidden py-6', dark ? 'bg-forest' : 'bg-sage']} aria-hidden="true">
  <div class="marquee-track flex w-max items-center gap-8 whitespace-nowrap">
    {[0, 1].map(() => (
      <span class="flex items-center gap-8">
        {row.map((word) => (
          <span class="flex items-center gap-8">
            <span class:list={['font-display text-4xl font-bold tracking-tight sm:text-5xl', dark ? 'text-cream' : 'text-forest']}>{word}</span>
            <span class="text-gold-deep text-2xl sm:text-4xl">✦</span>
          </span>
        ))}
      </span>
    ))}
  </div>
</div>
