---
import { blogPosts } from '../data/site';
import Picture from './Picture.astro';
const latest = blogPosts.slice(0, 3);
const fmt = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
---
<section class="bg-cream px-4 py-14 sm:px-6" aria-labelledby="home-blog-heading">
  <div class="mx-auto max-w-6xl">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="home-blog-heading" class="font-display text-3xl font-bold text-forest sm:text-4xl">Latest from the <span class="gold">journal</span></h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink/70">Honest guides on wedding menus, corporate catering, seasonal cooking and real costs.</p>
      </div>
      <a href="/blog/" class="rounded-full border border-forest/25 px-4 py-2 text-sm font-semibold text-forest transition hover:border-gold hover:text-gold-deep">All articles →</a>
    </div>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((p) => (
        <a href={`/blog/${p.slug}/`} class="reveal group overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-line">
          <Picture src={p.img} alt={p.title} width="640" height="420" loading="lazy" class="aspect-[3/2] w-full object-cover transition duration-300 group-hover:scale-105" />
          <div class="p-5">
            <p class="text-xs font-bold uppercase tracking-wider text-gold-deep">{p.category} · {fmt(p.date)} · {p.readingTime}</p>
            <h3 class="mt-2 font-display text-lg font-bold leading-snug text-forest group-hover:text-gold-deep">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/70">{p.excerpt}</p>
            <p class="mt-3 text-sm font-semibold text-forest">Read article <span class="text-gold-deep">→</span></p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
