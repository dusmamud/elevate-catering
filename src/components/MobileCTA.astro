---
import { contact, whatsappHref } from '../data/site';
const path = Astro.url.pathname;
const showBar = !['/quote/', '/contact/', '/tastings/'].includes(path);
---
{showBar && (
  <style>
    @media (max-width: 767.98px) {
      body { padding-bottom: 3.4rem; }
      #back-to-top { bottom: 4.6rem; }
      #toast { bottom: 4.6rem; }
    }
  </style>
  <nav aria-label="Quick actions" class="fixed inset-x-0 bottom-0 z-[60] grid grid-cols-3 border-t border-line bg-cream shadow-[0_-6px_24px_rgba(30,61,47,0.12)] md:hidden" style="padding-bottom: env(safe-area-inset-bottom)">
    <a href={contact.phoneHref} class="px-2 py-3.5 text-center text-sm font-bold text-forest transition hover:bg-sage">Call</a>
    <a href={whatsappHref} target="_blank" rel="noopener" class="border-x border-line px-2 py-3.5 text-center text-sm font-bold text-forest transition hover:bg-sage">WhatsApp</a>
    <a href="/quote/" class="bg-gold px-2 py-3.5 text-center text-sm font-bold text-forest transition hover:bg-forest hover:text-cream">Get a Quote</a>
  </nav>
)}
<a href={whatsappHref} target="_blank" rel="noopener" aria-label="Chat on WhatsApp with Elevate Catering" class:list={['fixed right-4 z-[60] hidden items-center gap-2 rounded-full bg-[#0b6b3a] py-3 pl-3.5 pr-4 text-sm font-bold text-white shadow-xl shadow-forest/30 transition hover:bg-[#09572f] md:flex', 'bottom-20']}>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
  WhatsApp
</a>
