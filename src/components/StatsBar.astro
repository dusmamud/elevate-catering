---
import { stats } from '../data/site';
---
<section class="bg-cream px-4 pb-4 pt-10 sm:px-6" aria-label="Our numbers">
  <div class="reveal mx-auto grid max-w-6xl grid-cols-2 gap-y-6 rounded-3xl bg-forest px-6 py-7 text-cream sm:grid-cols-4">
    {stats.map((s) => (
      <div class="text-center">
        {s.display ? (
          <p class="font-display text-3xl font-bold sm:text-4xl">{s.display}<span class="text-gold">★</span></p>
        ) : (
          <p class="font-display text-3xl font-bold sm:text-4xl"><span data-count={s.value}>{s.value.toLocaleString('en-IN')}</span><span class="text-gold">{s.suffix}</span></p>
        )}
        <p class="mt-1 text-xs font-semibold sm:text-sm">{s.label}</p>
        <p class="mt-0.5 text-[11px] text-cream/55 sm:text-xs">{s.sub}</p>
      </div>
    ))}
  </div>
</section>
