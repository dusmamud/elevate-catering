---
import { pillars } from '../data/site';
const icons: Record<string, string> = {
  chef: '<path d="M8 21h16M9 21v-3.2A5 5 0 0 1 6 13.5C6 10.5 8.2 8 11 8c.6-1.7 2-3 5-3s4.4 1.3 5 3c2.8 0 5 2.5 5 5.5A5 5 0 0 1 23 18v3" />',
  leaf: '<path d="M20 6C12 6 6 10 5 18c0 1 .5 2 1.5 2C14 20 20 14 20 6Z"/><path d="M5 21c2-6 6-10 11-12"/>',
  cloche: '<path d="M7 19a9 7 0 0 1 18 0"/><path d="M4 22h24"/><circle cx="16" cy="10" r="1.6"/>',
};
---
<section class="bg-cream px-4 pb-6 sm:px-6" aria-label="Why Elevate">
  <div class="mx-auto grid max-w-6xl gap-4 sm:grid-cols-3">
    {pillars.map((p) => (
      <article class="reveal rounded-2xl bg-white p-6 text-center shadow-sm ring-1 ring-line transition hover:-translate-y-1 hover:shadow-md">
        <svg width="44" height="44" viewBox="0 0 32 32" fill="none" stroke="#b9975b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mx-auto" aria-hidden="true" set:html={icons[p.icon]} />
        <h3 class="mt-3 font-display text-lg font-bold text-forest">{p.title}</h3>
        <p class="mt-1 text-sm text-ink/60">{p.text}</p>
      </article>
    ))}
  </div>
</section>
