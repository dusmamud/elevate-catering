---
import { contact, socials, site } from '../data/site';
import Cloche from './Cloche.astro';
const cols = [
  { title: 'Company', links: [{ href: '/about/', label: 'About Us' }, { href: '/team/', label: 'Our Team' }, { href: '/venues/', label: 'Venues' }, { href: '/gallery/', label: 'Gallery' }, { href: '/reviews/', label: 'Reviews' }, { href: '/process/', label: 'Our Process' }, { href: '/blog/', label: 'Blog' }, { href: '/faq/', label: 'FAQ' }] },
  { title: 'Services', links: [{ href: '/services/corporate-events/', label: 'Corporate Events' }, { href: '/services/weddings/', label: 'Weddings' }, { href: '/services/private-parties/', label: 'Private Parties' }, { href: '/services/gala-fundraisers/', label: 'Galas & Fundraisers' }, { href: '/services/drop-off-catering/', label: 'Drop-Off Catering' }, { href: '/services/full-service-events/', label: 'Full-Service Events' }] },
  { title: 'Menus', links: [{ href: '/menus/wedding-celebration/', label: 'Wedding Celebration' }, { href: '/menus/corporate-lunch/', label: 'Corporate Lunch' }, { href: '/menus/private-party/', label: 'Private Party' }, { href: '/menus/seasonal-tasting/', label: 'Seasonal Tasting' }, { href: '/pricing/', label: 'Pricing — from ₹1,450/guest' }] },
  { title: 'Support', links: [{ href: '/contact/', label: 'Contact Us' }, { href: '/quote/', label: 'Get a Quote' }, { href: '/pricing/', label: 'Pricing' }, { href: '/search/', label: 'Search' }, { href: '/privacy/', label: 'Privacy Policy' }, { href: '/terms/', label: 'Terms of Service' }] },
];
---
<footer class="bg-forest px-4 pb-6 pt-12 text-cream sm:px-6">
  <div class="mx-auto max-w-6xl">
    <div class="flex flex-col gap-10 border-b border-white/15 pb-10 lg:flex-row lg:justify-between">
      <div class="max-w-xs shrink-0">
        <a href="/" class="flex items-center gap-2">
          <Cloche size={34} />
          <span class="leading-none"><span class="block font-display text-xl font-bold tracking-[0.18em]">ELEVATE</span><span class="block text-[10px] font-semibold tracking-[0.42em] text-gold">CATERING</span></span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-cream/70">Culinary excellence for corporate events, weddings & special occasions. FSSAI licensed · Mumbai, Delhi & Bengaluru.</p>
        <p class="mt-4 text-sm font-semibold">{contact.email}</p>
        <p class="text-sm font-semibold">{contact.phoneDisplay}</p>
        <p class="mt-1 text-xs text-cream/55">{contact.location}</p>
        <p class="mt-1 text-xs text-cream/55">{contact.hours}</p>
      </div>
      <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
        {cols.map((c) => (
          <div>
            <h3 class="font-display text-sm font-bold uppercase tracking-wider text-gold">{c.title}</h3>
            <ul class="mt-3 space-y-2 text-sm">
              {c.links.map((l) => (<li><a href={l.href} class="text-cream/70 transition hover:text-cream hover:underline">{l.label}</a></li>))}
            </ul>
          </div>
        ))}
      </div>
      <div class="max-w-xs shrink-0">
        <h3 class="font-display text-sm font-bold uppercase tracking-wider text-gold">Seasonal menus, monthly</h3>
        <p class="mt-3 text-sm text-cream/70">New menus, tasting invites and hosting ideas — once a month. No spam.</p>
        <form id="newsletter-form" novalidate class="mt-3 flex overflow-hidden rounded-full border border-white/25 bg-white/10">
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input id="newsletter-email" type="email" required placeholder="Enter your email" aria-describedby="newsletter-email-error" class="w-full min-w-0 bg-transparent px-4 py-2.5 text-sm text-cream outline-none placeholder:text-cream/45" />
          <button type="submit" class="shrink-0 bg-gold px-4 text-sm font-semibold text-forest transition hover:bg-cream">Join</button>
        </form>
        <p id="newsletter-email-error" class="field-error invisible text-red-300" role="alert"></p>
        <p id="newsletter-ok" class="mt-2 hidden text-sm font-semibold text-gold">Thanks — you are on the list.</p>
      </div>
    </div>
    <div class="flex flex-col items-center justify-between gap-4 pt-6 sm:flex-row">
      <p class="text-xs text-cream/60">© {site.year} Elevate Catering. All rights reserved. (Demo — mock content)</p>
      <div class="flex items-center gap-2">
        {socials.map((s) => (
          s.href === '#' ? (
            <span role="img" aria-label={s.label} class="grid h-9 w-9 place-items-center rounded-full border border-white/25 text-cream transition hover:bg-gold hover:text-forest"><span aria-hidden="true" class="text-[11px] font-bold">{s.label.slice(0, 2).toUpperCase()}</span></span>
          ) : (
            <a href={s.href} aria-label={s.label} class="grid h-9 w-9 place-items-center rounded-full border border-white/25 text-cream transition hover:bg-gold hover:text-forest"><span class="text-[11px] font-bold">{s.label.slice(0, 2).toUpperCase()}</span></a>
          )
        ))}
      </div>
    </div>
  </div>
</footer>
