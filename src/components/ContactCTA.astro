---
import { contact } from '../data/site';
import Picture from './Picture.astro';
---
<section class="bg-cream px-4 pb-16 pt-6 sm:px-6" aria-labelledby="contact-heading">
  <div class="reveal mx-auto grid max-w-6xl items-center gap-8 rounded-3xl bg-forest px-6 py-10 text-cream sm:px-10 lg:grid-cols-2">
    <div>
      <h2 id="contact-heading" class="font-display text-3xl font-bold leading-tight sm:text-4xl">Let's plan your <span class="text-gold">event</span></h2>
      <p class="mt-3 max-w-md text-sm leading-relaxed text-cream/70">Tell us your date and guest count — we reply within one working day with availability and a tasting invite.</p>
      <form id="contact-cta-form" novalidate class="mt-6 flex max-w-md overflow-hidden rounded-full border border-white/25 bg-white/10">
        <label class="sr-only" for="cta-email">Email address</label>
        <input id="cta-email" type="email" required placeholder="Enter your email" aria-describedby="cta-email-error" class="w-full min-w-0 bg-transparent px-5 py-3.5 text-sm text-cream outline-none placeholder:text-cream/40" />
        <button type="submit" data-magnetic class="shrink-0 bg-gold px-5 text-sm font-semibold text-forest transition hover:bg-cream">Get a Quote</button>
      </form>
      <p id="cta-email-error" class="field-error invisible text-red-300" role="alert"></p>
      <p id="contact-cta-ok" class="mt-3 hidden max-w-md text-sm font-semibold text-gold">Thanks! Your mail app will open — just press send.</p>
      <p class="mt-4 text-sm text-cream/70">Or write directly: <a class="font-semibold text-cream underline decoration-gold underline-offset-4" href={`mailto:${contact.email}`}>{contact.email}</a> · {contact.phoneDisplay}</p>
    </div>
    <div class="overflow-hidden rounded-2xl">
      <Picture src="/images/tablescape.jpg" alt="An elegant Elevate Catering wedding tablescape with gold cutlery" width="1000" height="667" loading="lazy" class="h-full max-h-[420px] w-full object-cover" />
    </div>
  </div>
</section>
