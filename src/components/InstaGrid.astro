---
import Picture from './Picture.astro';
import { galleryItems } from '../data/site';
const tiles = galleryItems.slice(0, 6);
---
<section class="bg-cream px-4 py-14 sm:px-6" aria-labelledby="insta-heading">
  <div class="mx-auto max-w-6xl">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="insta-heading" class="font-display text-3xl font-bold text-forest sm:text-4xl">Follow the <span class="gold">feast</span></h2>
        <p class="mt-2 max-w-xl text-sm leading-relaxed text-ink/70">Behind-the-scenes plates, tablescapes and tasting days — our kitchen, as it happens.</p>
      </div>
      <span class="rounded-full border border-forest/25 px-4 py-2 text-sm font-semibold text-forest">@elevatecatering · Instagram (coming soon)</span>
    </div>
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {tiles.map((g) => (
        <a href="#" aria-label="Elevate Catering on Instagram (coming soon)" class="reveal project-card group block overflow-hidden rounded-2xl">
          <Picture src={g.img} alt={g.title} width={480} height={480} sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 16vw" class="aspect-square w-full object-cover" />
        </a>
      ))}
    </div>
  </div>
</section>
